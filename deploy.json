{
  "version": 1,
  "project": "commerce/stall",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": ""
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "PIER_ORIGIN",
      "environment": "PIER_ORIGIN",
      "optional": true
    },
    {
      "binding": "PIER_SESSION",
      "environment": "PIER_SESSION",
      "optional": true
    },
    {
      "binding": "PIER_CUSTOMER_ID",
      "environment": "PIER_CUSTOMER_ID",
      "optional": true
    },
    {
      "binding": "STRIPE_SECRET_KEY",
      "environment": "STRIPE_SECRET_KEY",
      "optional": true
    },
    {
      "binding": "STRIPE_WEBHOOK_SECRET",
      "environment": "STRIPE_WEBHOOK_SECRET",
      "optional": true
    }
  ]
}
