{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party",
        "node scripts/contract-docs.mjs check CATALOG-002",
        "pnpm run typecheck"
      ]
    },
    {
      "name": "commerce",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm exec node --test --test-concurrency=1 tests/api/commerce.test.mjs tests/api/data.test.mjs tests/api/dev-invitations.test.mjs tests/api/demo.test.mjs tests/api/operations.test.mjs tests/api/returns.test.mjs tests/api/pier-work.test.mjs tests/api/local-payments.test.mjs tests/api/shipping.test.mjs tests/api/customer-registration.test.mjs tests/api/customer-balances.test.mjs tests/api/customer-history.test.mjs"
      ]
    },
    {
      "name": "movein",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm exec node --test --test-concurrency=1 tests/api/imports.test.mjs"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "pnpm run test:runtime"
      ]
    },
    {
      "name": "customer-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/ui/real-home.mjs tests/ui/customer-account-journey.mjs",
        "node tests/ui/real-home.mjs tests/ui/customer-directory-journey.mjs",
        "node tests/ui/real-home.mjs tests/ui/customer-registration-journey.mjs",
        "node tests/ui/real-home.mjs tests/ui/customer-history-journey.mjs",
        "node tests/ui/real-home.mjs tests/ui/customer-balances-journey.mjs",
        "node tests/ui/real-home.mjs tests/ui/customer-order-status-journey.mjs"
      ]
    },
    {
      "name": "channel-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/ui/real-home.mjs tests/ui/buy-link-journey.mjs"
      ]
    },
    {
      "name": "review-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "node tests/ui/real-home.mjs tests/ui/review-import-journey.mjs",
        "node tests/ui/real-home.mjs tests/ui/bulk-products-journey.mjs"
      ]
    },
    {
      "name": "analytics-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/ui/real-home.mjs tests/ui/analytics-journey.mjs"
      ]
    }
  ],
  "nightly": [
    {
      "name": "browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run test:browser",
        "node tests/ui/integration-journey.mjs",
        "node tests/ui/merch-proposals-journey.mjs",
        "pnpm run build && node tests/ui/merch-seo-journey.mjs",
        "node tests/ui/real-home.mjs tests/ui/staff-journey.mjs",
        "node tests/ui/real-home.mjs tests/ui/promotion-journey.mjs",
        "node tests/ui/real-home.mjs tests/ui/request-journey.mjs"
      ]
    },
    {
      "name": "readme-clone",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:clone"
      ]
    },
    {
      "name": "shipping-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/ui/shipping-journey.mjs"
      ]
    },
    {
      "name": "tax-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/ui/real-home.mjs tests/ui/tax-settings-journey.mjs",
        "node tests/ui/real-home.mjs tests/ui/tax-commerce-journey.mjs"
      ]
    }
  ]
}
