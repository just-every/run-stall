{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party",
        "pnpm run typecheck"
      ]
    },
    {
      "name": "commerce",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm exec node --test --test-concurrency=1 tests/api/commerce.test.mjs tests/api/data.test.mjs tests/api/dev-invitations.test.mjs tests/api/demo.test.mjs tests/api/operations.test.mjs tests/api/pier-work.test.mjs tests/api/local-payments.test.mjs"
      ]
    },
    {
      "name": "movein",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm exec node --test --test-concurrency=1 tests/api/imports.test.mjs"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "pnpm run test:runtime",
        "node --test tests/site/site.test.mjs"
      ]
    }
  ],
  "nightly": [
    {
      "name": "browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run test:browser",
        "node tests/ui/integration-journey.mjs",
        "node tests/ui/bulk-products-journey.mjs",
        "node tests/ui/staff-journey.mjs"
      ]
    },
    {
      "name": "readme-clone",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:clone"
      ]
    }
  ]
}
